# Chat generation: DeepSeek/OpenAI-compatible API.
CHAT_PROVIDER=openai
CHAT_API_KEY=sk-7c36d399551544b89e8baae151743bcc
#CHAT_API_KEY=tp-clg8sstpk6qrp7huspgq6bpcof85sc3bvyq4ul3eoc0sku10
CHAT_API_BASE=https://api.deepseek.com
#CHAT_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
CHAT_MODEL=deepseek-v4-pro

# Embedding: local Ollama by default.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Optional API embedding provider. Only required when EMBEDDING_PROVIDER=openai.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1

# Backward-compatible OpenAI-style envs. Used as fallback for CHAT_API_*.
OPENAI_API_KEY=
OPENAI_API_BASE=

# Local service URLs.
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434

# RAG runtime.
RAG_CACHE_TTL_SECONDS=3600
CHAT_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=10
JOB_MAX_RETRIES=3

# v2.0: Vision API for image captioning (defaults to CHAT_API_* values if not set).
# IMPORTANT: Requires a multimodal model. DeepSeek v4-pro is text-only, use gpt-4o or similar.
VISION_API_KEY=
VISION_API_BASE=
VISION_MODEL=gpt-4o
