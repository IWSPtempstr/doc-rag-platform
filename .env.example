# Chat generation: DeepSeek/OpenAI-compatible API.
CHAT_PROVIDER=openai
CHAT_API_KEY=
CHAT_API_BASE=https://your-api-endpoint.com
CHAT_MODEL=your-chat-model

# Embedding: local Ollama by default.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Optional API embedding provider. Only required when EMBEDDING_PROVIDER=openai.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1

# Backward-compatible OpenAI-style envs. Used as fallback for CHAT_API_*.
OPENAI_API_KEY=
OPENAI_API_BASE=

# Local service URLs.
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434

# RAG runtime.
RAG_CACHE_TTL_SECONDS=3600
CHAT_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=10
JOB_MAX_RETRIES=3

# v2.0: Vision API for image captioning (defaults to CHAT_API_* values if not set).
# IMPORTANT: Requires a multimodal model. DeepSeek v4-pro is text-only, use gpt-4o or similar.
VISION_API_KEY=
VISION_API_BASE=
VISION_MODEL=gpt-4o

# Auth / SEC / public datasets.
AUTH_SECRET=change-me-in-production
# SEC requires a descriptive User-Agent with contact information.
SEC_USER_AGENT=FinancialRAGWorkbench/0.1 your-email@example.com

# Public-data-only finance demo sources:
# - SEC EDGAR 10-K / CompanyFacts
# - FinQA: https://huggingface.co/datasets/ibm-research/finqa
# - TAT-QA: https://huggingface.co/datasets/next-tat/TAT-QA
# - FinanceBench sample is optional and non-commercial licensed.
